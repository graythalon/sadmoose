<Window x:Class="Drift.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Drift — Shared input" Height="680" Width="820" MinHeight="570" MinWidth="690" Background="#0C1017" Foreground="#F3F5F8" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="DRIFT  /  WINDOWS HUB" Foreground="#C8F36A" FontSize="10" FontWeight="Bold"/><TextBlock Text="One pointer. Every screen." FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#1C242C" CornerRadius="8" Padding="10,7" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Sharing paused" Foreground="#AAB3C2"/></Border></DockPanel>
    <Border Grid.Row="1" Background="#151B25" BorderBrush="#293241" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="This PC is your desk hub" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Devices join this trusted local network. Input stays paused until you start sharing." Foreground="#9AA3B2" Margin="0,5,0,12" TextWrapping="Wrap"/><TextBlock x:Name="HostAddress" Text="Host address: starting…" Foreground="#CDD3DE" FontSize="11"/><TextBlock x:Name="PairCode" Text="Pairing key: not created" Foreground="#CDD3DE" FontSize="11" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="CreateCodeButton" Content="Create pairing key" Click="CreateCode_Click"/><Button x:Name="CopyCodeButton" Content="Copy key" Click="CopyCode_Click" IsEnabled="False"/></StackPanel></Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#121720" BorderBrush="#252D3A" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="PAIRED DEVICES" Foreground="#919AAA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="EmptyDevices" Text="No devices connected yet.&#10;&#10;On a Mac or Android device, install Drift, enter this PC’s IP address and pairing key, then connect." Foreground="#A7AEBB" Margin="0,16,0,0" TextWrapping="Wrap"/><ListBox x:Name="DeviceList" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="#E8EBF1" DisplayMemberPath="DisplayName" SelectionChanged="DeviceList_SelectionChanged"/><Button x:Name="DisconnectDeviceButton" Content="Disconnect selected device" Click="DisconnectDevice_Click" IsEnabled="False" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#121720" BorderBrush="#252D3A" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="INPUT SHARING" Foreground="#919AAA" FontSize="10" FontWeight="Bold"/><TextBlock Text="Input owner" FontWeight="SemiBold" Margin="0,16,0,4"/><ComboBox x:Name="TargetPicker" SelectionChanged="TargetPicker_SelectionChanged" Background="#202735" Foreground="#E8EBF1" Padding="6"/><TextBlock Text="Choose the device that should receive your PC mouse and keyboard. Connected devices can also send their attached mouse and keyboard back through this hub." Foreground="#959EAD" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16"/><CheckBox x:Name="MouseSharing" Content="Share mouse and trackpad" Foreground="#E8EBF1" IsChecked="True" Checked="SharingChanged" Unchecked="SharingChanged" Margin="0,4"/><CheckBox x:Name="KeyboardSharing" Content="Share keyboard" Foreground="#E8EBF1" IsChecked="True" Checked="SharingChanged" Unchecked="SharingChanged" Margin="0,4"/><Button x:Name="StartSharingButton" Content="Start sharing" Click="StartSharing_Click" Margin="0,18,0,0"/><TextBlock Text="Emergency return: Ctrl + Alt + Shift + Backspace" Foreground="#8791A1" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="Only paired peers with the active key can connect. Pause or stop sharing here at any time." Foreground="#737D8D" FontSize="10" Margin="2,18,0,0"/>
  </Grid>
</Window>
